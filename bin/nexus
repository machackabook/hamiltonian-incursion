#!/data/data/com.termux/files/usr/bin/env bash
# Nexus — Normal admin / non-root universal dispatcher
# Continuity Engine × Hamiltonian Incursion
# Numeral 137451921129154222
# Usage: nexus scan | nexus workforce | nexus ledger | ...
# No bash prefix required. Hotswappable extensions.
set -euo pipefail

NEXUS_ROOT="${NEXUS_ROOT:-$HOME/hamiltonian-incursion}"
if [[ ! -d "$NEXUS_ROOT" ]]; then
  for candidate in "$HOME/hamiltonian-incursion" "$HOME/strange-loop-a15-controller" "$(pwd)"; do
    if [[ -d "$candidate/scripts" || -d "$candidate/device" ]]; then
      NEXUS_ROOT="$candidate"
      break
    fi
  done
fi

NUMERAL="137451921129154222"
CMD="${1:-help}"
shift || true

# Load hotswappable extensions
EXT_DIR="$NEXUS_ROOT/extensions"
if [[ -d "$EXT_DIR" ]]; then
  for ext in "$EXT_DIR"/*.sh; do
    [[ -f "$ext" ]] && source "$ext" 2>/dev/null || true
  done
fi

case "$CMD" in
  scan|sentinel)
    exec bash "$NEXUS_ROOT/scripts/continuity-sentinel.sh" "$@"
    ;;
  assist|auto)
    exec bash "$NEXUS_ROOT/scripts/hi-auto-assist.sh" "$@"
    ;;
  workforce|work)
    exec bash "$NEXUS_ROOT/scripts/hi-workforce.sh" "$@"
    ;;
  prune)
    exec bash "$NEXUS_ROOT/scripts/device_prune.sh" "$@"
    ;;
  detect|class)
    exec bash "$NEXUS_ROOT/device/detect.sh" "$@"
    ;;
  profile)
    exec bash "$NEXUS_ROOT/profiles/create_profile.sh" "$@"
    ;;
  bg|background)
    exec bash "$NEXUS_ROOT/backgrounds/set_dynamic_bg.sh" "$@"
    ;;
  pipethru|pipe)
    exec bash "$NEXUS_ROOT/scripts/pipethru.sh" "$@"
    ;;
  ledger)
    tail -n "${1:-50}" "${HOME}/strange-loop-a15-controller/continuity_ledger.jsonl" 2>/dev/null || echo "ledger not yet created"
    ;;
  strength)
    python3 "${HOME}/strange-loop-a15-controller/agents/error_corrector.py" \
      --ledger "${HOME}/strange-loop-a15-controller/continuity_ledger.jsonl" \
      --remedy "${HOME}/strange-loop-a15-controller/.github/remedy" \
      --numeral "$NUMERAL" "$@"
    ;;
  pull|update)
    cd "$NEXUS_ROOT" && git pull --ff-only origin main
    ;;
  ext|extensions)
    if [[ "${1:-}" == "pull" ]]; then
      echo "[NEXUS] Extension pull — official repo only"
      cd "$NEXUS_ROOT" && git pull --ff-only origin main
      echo "[NEXUS] Extensions refreshed"
    else
      ls -1 "$EXT_DIR" 2>/dev/null || echo "no extensions directory"
    fi
    ;;
  runtime|rt)
    echo "[NEXUS] Runtime probe (local only)"
    for r in python python3 pip pip3 bun uv node npm; do
      if command -v "$r" >/dev/null 2>&1; then
        echo "  present: $r → $(command -v $r)"
      else
        echo "  missing: $r"
      fi
    done
    ;;
  help|--help|-h|"")
    cat << EOF
Nexus — normal admin dispatcher (non-root)
Numeral $NUMERAL

Usage: nexus <command> [args]

Core:
  scan / sentinel     Continuity sentinel
  assist / auto       Full auto-assist suite
  workforce / work    Device-aware workforce pipeline
  prune               Prune foreign device artifacts
  detect / class      Titrate device class
  profile [name]      Create Azazel profile
  bg / background     Dynamic Termux visual identity
  pipethru <file>     Declarative low-syntax pipeline
  ledger [n]          Show last n ledger lines
  strength            Error-corrector strength pass
  pull / update       git pull from official repo
  ext / extensions    List or 'ext pull'
  runtime / rt        Probe pip / bun / uv / node / python

Elevated surface: use 'nxus' (root-intent commands)
Extensions in $EXT_DIR are hotswappable.
EOF
    ;;
  *)
    if declare -F "hi_ext_$CMD" >/dev/null 2>&1; then
      "hi_ext_$CMD" "$@"
    elif declare -F "nexus_ext_$CMD" >/dev/null 2>&1; then
      "nexus_ext_$CMD" "$@"
    else
      echo "[NEXUS] Unknown command: $CMD"
      echo "Run: nexus help"
      exit 1
    fi
    ;;
esac
